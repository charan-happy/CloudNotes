# Copy this file to .env and fill in values before running docker compose.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=cloudnotes
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=cloudnotes

# Cloud-agnostic connection string. Point this at any managed PostgreSQL:
#   AWS RDS:   postgresql://user:pass@mydb.xxxx.rds.amazonaws.com:5432/cloudnotes
#   GCP:       postgresql://user:pass@/cloudnotes?host=/cloudsql/PROJECT:REGION:INSTANCE
#   Azure:     postgresql://user:pass@mydb.postgres.database.azure.com:5432/cloudnotes
#   OCI / local: postgresql://cloudnotes:cloudnotes@postgres:5432/cloudnotes
DATABASE_URL=postgresql://cloudnotes:cloudnotes@postgres:5432/cloudnotes

# ── JWT (shared by all services that issue/verify tokens) ────────────────────
# MUST be >= 32 characters (256 bits) — required by HS256. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ── Connection pool tuning (per service) ─────────────────────────────────────
DB_POOL_MIN=5
DB_POOL_MAX=20

# ── Real-time collaboration (frontend → collab-service) ──────────────────────
# Browser-side WebSocket URL for the Hocuspocus/Yjs server. Must be reachable
# from the user's browser (the host), not the docker network name.
NEXT_PUBLIC_COLLAB_URL=ws://localhost:8004

# ── Observability (you wire the backends; apps already emit/honor these) ─────
# Services emit structured JSON logs to stdout — ship with PLG / ELK / CloudWatch.
LOG_LEVEL=info
# Jaeger / OpenTelemetry: set the collector endpoint and the app exports traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME is set per service.

# ── AI note assistant (optional — frontend /api/ai route) ────────────────────
# Leave unset to disable AI features gracefully.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-6
